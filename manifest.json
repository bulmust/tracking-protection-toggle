{
  "manifest_version": 2,
  "name": "Tracking Protection Toggle",
  "version": "1.0.0",
  "author": "Taygun Bulmus",
  "description": "Quickly enable or disable Firefox's built-in Enhanced Tracking Protection with a single click.",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "privacy"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Tracking Protection Toggle"
  },
  "background": {
    "scripts": ["background/background.js"],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tracking-protection-toggle@antigravity",
      "strict_min_version": "67.0"
    }
  }
}
